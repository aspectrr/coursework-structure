{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the main window",
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:41794"]
  },
  "permissions": [
    "core:default",
    "allow-today-get",
    "allow-calendar-get",
    "allow-admin-list-courses",
    "allow-admin-import",
    "allow-mark-item-complete",
    "allow-course-detail",
    "allow-item-detail",
    "allow-notes-read",
    "allow-notes-write",
    "allow-video-notes-list",
    "allow-video-notes-create",
    "allow-video-notes-update",
    "allow-video-notes-delete",
    "allow-get-courses-dir",
    "allow-pick-courses-dir",
    "allow-preview-import",
    "allow-convert-local-path-to-url",
    "dialog:allow-open",
    "shell:allow-open",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPLOCALDATA/**" },
        { "path": "$HOME/**" }
      ]
    }
  ]
}
